# LLM credential injected into Codex child processes.
OPENAI_API_KEY=replace-me

# Feishu long-connection channel. Keep all three values together.
FEISHU_GATEWAY_ID=main
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace-me
FEISHU_USE_SYSTEM_PROXY=false

# Optional WeCom long-connection channel. Set both values or leave both empty.
WECOM_BOT_ID=
WECOM_SECRET=
WECOM_CALLBACK_AES_KEY=
WECOM_SESSION_IDLE=30m
WECOM_MAX_TURN=

# Bind locally unless a reverse proxy/firewall policy explicitly requires more.
RELAY_HOST=127.0.0.1
RELAY_API_HOST=127.0.0.1
RELAY_PORT=9500
RELAY_API_PORT=9501
